# ═══════════════════════════════════════════════════
# 🔒 SENSITIVE FILES - CRITICAL! NEVER COMMIT THESE!
# ═══════════════════════════════════════════════════

# API Keys (Gemini, etc.)
lib/core/constants/api_keys.dart

# Firebase Configuration (contains project secrets)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json

# Android Signing Keys (used to sign release APKs)
key.properties
android/key.properties
*.jks
*.keystore

# iOS Provisioning & Certificates
*.mobileprovision
*.p12
*.cer

# Environment files (if you ever use them)
.env
.env.local
.env.production

